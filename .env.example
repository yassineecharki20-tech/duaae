# ============================================================================
# DUAA | دعاء — environment template
# ============================================================================
# Copy this file to `.env` and fill in the values for your Firebase project:
#
#     cp .env.example .env
#
# Rules this project follows (enforced by src/core/config/env.ts):
#
#   * Only `EXPO_PUBLIC_*` variables exist. Expo inlines them into the client
#     bundle at build time — they are PUBLIC by design, so they must never be
#     secrets. Service-account keys, Admin SDK credentials, signing keys and any
#     other private material belong to a backend or to the EAS secret store and
#     must never be added here.
#   * `.env` is git-ignored. Never commit real values.
#   * Every variable is OPTIONAL. The app is offline-first: with no Firebase
#     values, `config.firebase.isConfigured` is `false` and the affected
#     services (auth, database, community, users, notifications) return an
#     honest `NOT_CONFIGURED` AppError that the UI renders verbatim in Arabic.
#     Nothing fakes success. See docs/FIREBASE-INTEGRATION.md for the wiring.
#   * Blank values are treated as absent (env.ts trims and drops empty strings).

# ----------------------------------------------------------------------------
# App metadata
# ----------------------------------------------------------------------------
# development | preview | production. Drives `config.isProduction`,
# debug logging defaults and analytics gating.
EXPO_PUBLIC_APP_ENV=development

# Displayed in About/Share branding. Defaults to "DUAA | دعاء" when unset.
EXPO_PUBLIC_APP_NAME=DUAA | دعاء

# Contact address shown on the About screen and in the feedback sheet.
EXPO_PUBLIC_SUPPORT_EMAIL=support@duaa.app

# Legal links opened from Settings → About.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://duaa.app/legal/privacy
EXPO_PUBLIC_TERMS_URL=https://duaa.app/legal/terms

# ----------------------------------------------------------------------------
# Firebase Web/App client config (public values only)
# ----------------------------------------------------------------------------
# Firebase console → Project settings → General → Your apps → SDK setup and
# configuration. All seven come from that single snippet. The five marked
# (required) decide `isConfigured`; the other two are optional extras.
EXPO_PUBLIC_FIREBASE_API_KEY=                      # required
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=                  # required — e.g. your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=                   # required
EXPO_PUBLIC_FIREBASE_APP_ID=                       # required — e.g. 1:1234567890:web:abcdef
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=          # required — numeric sender id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=               # optional — e.g. your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=               # optional — needed for GA4

# ----------------------------------------------------------------------------
# Diagnostics
# ----------------------------------------------------------------------------
# Analytics events are only dispatched when this is true AND Firebase is
# configured; otherwise the analytics service is a no-op that records nothing.
EXPO_PUBLIC_ANALYTICS_ENABLED=false

# Verbose console diagnostics. Defaults to true outside production.
EXPO_PUBLIC_DEBUG_LOGGING=false
